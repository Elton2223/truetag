---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../content/site';

export const prerender = false;
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
---
<Base title="For brands">
  <div class="wrap page-head">
    <h1>Protect your brand</h1>
    <div class="cta-row">
      <a class="btn" href="#pilot">Request a pilot</a>
      <a class="btn ghost" href="/demo">Try the demo</a>
      <a class="btn ghost" href="/portal/login">Brand portal</a>
    </div>
  </div>
  <section>
    <div class="wrap">
      <ol class="timeline">
        <li><strong>Enquire</strong><span class="muted">Form or WhatsApp</span></li>
        <li><strong>Pilot</strong><span class="muted">One product, first scans</span></li>
        <li><strong>Dashboard</strong><span class="muted">Scans, flags, places</span></li>
        <li><strong>Act</strong><span class="muted">Evidence on fakes</span></li>
      </ol>
    </div>
  </section>
  <section class="band">
    <div class="wrap grid three" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
      <div class="tile"><span class="ico" style="background:rgba(255,255,255,.12)"><Icon name="chart" /></span><h3>Scan summary</h3></div>
      <div class="tile"><span class="ico" style="background:rgba(255,255,255,.12)"><Icon name="flag" /></span><h3>Suspicious activity</h3></div>
      <div class="tile"><span class="ico" style="background:rgba(255,255,255,.12)"><Icon name="inbox" /></span><h3>Consumer reports</h3></div>
      <div class="tile"><span class="ico" style="background:rgba(255,255,255,.12)"><Icon name="pdf" /></span><h3>Monthly PDF</h3></div>
    </div>
  </section>
  <section id="pilot">
    <div class="wrap grid two">
      <div>
        <h2>Request a pilot</h2>
        <p class="muted">We vet company registration and relevant licences before issuing codes.</p>
        <a class="btn ghost" href={whatsappLink('Hi True Tag, I am a brand and I would like to enquire about a pilot.')}>WhatsApp us</a>
      </div>
      <div>
        {ok && <div class="card" style="margin-bottom:1rem;border-left:4px solid var(--ok)">Thanks — we received your pilot request.</div>}
        {err && <div class="card" style="margin-bottom:1rem;border-left:4px solid var(--bad)">Please fill in company, name and email.</div>}
        <form class="pilot card" method="post" action="/api/v1/pilots">
          <label>Company<input name="company" required /></label>
          <label>Your name<input name="name" required /></label>
          <label>Email<input name="email" type="email" required /></label>
          <label>Product
            <select name="type"><option>Alcohol</option><option>Cigarettes</option><option>Other</option></select>
          </label>
          <label>Message<textarea name="msg" rows="3"></textarea></label>
          <button class="btn" type="submit">Send</button>
        </form>
      </div>
    </div>
  </section>
</Base>
