---
import AppShell from '../../layouts/AppShell.astro';
import { query, type Row } from '../../lib/db';
import { formatWhen } from '../../lib/format';

export const prerender = false;
const user = Astro.locals.user!;

const scans = await query<Row[]>(
  `SELECT s.created_at, s.channel, s.verdict, s.city_approx, c.code, p.name AS product_name, br.name AS brand_name
   FROM scan_events s
   JOIN codes c ON c.id = s.code_id
   JOIN batches b ON b.id = c.batch_id
   JOIN products p ON p.id = b.product_id
   JOIN brands br ON br.id = p.brand_id
   ORDER BY s.created_at DESC LIMIT 100`,
);
---
<AppShell title="Scans" area="admin" userName={user.name}>
  <h1>Scan events</h1>
  <p class="muted">Latest 100 lookups. IPs are stored hashed.</p>
  <table class="data">
    <thead><tr><th>When</th><th>Code</th><th>Verdict</th><th>Channel</th><th>City</th><th>Product</th></tr></thead>
    <tbody>
      {scans.map((s) => (
        <tr>
          <td>{formatWhen(s.created_at)}</td>
          <td><code>{s.code}</code></td>
          <td><span class={`pill ${s.verdict === 'genuine' ? 'ok' : s.verdict === 'suspicious' ? 'warn' : 'bad'}`}>{s.verdict}</span></td>
          <td>{s.channel}</td>
          <td>{s.city_approx || '—'}</td>
          <td>{s.brand_name} · {s.product_name}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AppShell>
