---
import AppShell from '../../layouts/AppShell.astro';
import { query, type Row } from '../../lib/db';

export const prerender = false;
const user = Astro.locals.user!;

const batches = await query<Row[]>(
  `SELECT b.id, b.label, p.name AS product_name, br.name AS brand_name,
          (SELECT COUNT(*) FROM codes c WHERE c.batch_id = b.id) AS code_count
   FROM batches b
   JOIN products p ON p.id = b.product_id
   JOIN brands br ON br.id = p.brand_id
   ORDER BY b.created_at DESC LIMIT 100`,
);

const recent = await query<Row[]>(
  `SELECT c.code, c.status, c.scan_count, c.scan_limit, p.name AS product_name, br.name AS brand_name
   FROM codes c
   JOIN batches b ON b.id = c.batch_id
   JOIN products p ON p.id = b.product_id
   JOIN brands br ON br.id = p.brand_id
   ORDER BY c.created_at DESC LIMIT 50`,
);
---
<AppShell title="Codes" area="admin" userName={user.name}>
  <h1>Codes</h1>
  <p class="muted">Pick a batch to generate or export codes.</p>
  <table class="data">
    <thead><tr><th>Brand</th><th>Product</th><th>Batch</th><th>Codes</th><th></th></tr></thead>
    <tbody>
      {batches.map((b) => (
        <tr>
          <td>{b.brand_name}</td>
          <td>{b.product_name}</td>
          <td>{b.label}</td>
          <td>{b.code_count}</td>
          <td><a href={`/admin/batches/${b.id}`}>Open</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <h2 style="margin-top:2rem">Recent codes</h2>
  <table class="data">
    <thead><tr><th>Code</th><th>Brand</th><th>Product</th><th>Status</th><th>Scans</th></tr></thead>
    <tbody>
      {recent.map((c) => (
        <tr>
          <td><code>{c.code}</code></td>
          <td>{c.brand_name}</td>
          <td>{c.product_name}</td>
          <td><span class={`pill ${c.status === 'active' ? 'ok' : c.status === 'flagged' ? 'warn' : 'bad'}`}>{c.status}</span></td>
          <td>{c.scan_count}/{c.scan_limit}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AppShell>
