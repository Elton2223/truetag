---
import AppShell from '../../../layouts/AppShell.astro';
import { query, type Row } from '../../../lib/db';

export const prerender = false;
const user = Astro.locals.user!;
const brandId = user.brandId!;
const id = Astro.params.id!;

const products = await query<Row[]>(
  `SELECT * FROM products WHERE id = :id AND brand_id = :brandId`,
  { id, brandId },
);
const product = products[0];
if (!product) return Astro.redirect('/portal/products');

const batches = await query<Row[]>(
  `SELECT b.*, (SELECT COUNT(*) FROM codes c WHERE c.batch_id = b.id) AS code_count
   FROM batches b WHERE product_id = :id ORDER BY created_at DESC`,
  { id },
);
const flash = Astro.url.searchParams.get('ok');
---
<AppShell title={product.name} area="portal" userName={user.name}>
  <p><a href="/portal/products">← Products</a></p>
  <h1>{product.name}</h1>
  {flash && <div class="flash">Saved.</div>}
  <form class="stack-form card" method="post" action="/api/v1/brands/me/batches">
    <input type="hidden" name="product_id" value={product.id} />
    <label>Batch label<input name="label" required /></label>
    <label>Manufactured<input type="date" name="manufactured_on" /></label>
    <label>Expires<input type="date" name="expires_on" /></label>
    <button class="btn" type="submit">Create batch</button>
  </form>
  <h2 style="margin-top:2rem">Batches</h2>
  <table class="data">
    <thead><tr><th>Label</th><th>Codes</th><th></th></tr></thead>
    <tbody>
      {batches.map((b) => (
        <tr>
          <td>{b.label}</td>
          <td>{b.code_count}</td>
          <td><a href={`/portal/batches/${b.id}`}>Generate / export</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</AppShell>
