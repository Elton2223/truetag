---
import AppShell from '../../layouts/AppShell.astro';
import { query, type Row } from '../../lib/db';

export const prerender = false;
const user = Astro.locals.user!;
const brandId = user.brandId!;

const flagged = await query<Row[]>(
  `SELECT c.code, c.scan_count, c.scan_limit, p.name AS product_name, b.label AS batch_label
   FROM codes c
   JOIN batches b ON b.id = c.batch_id
   JOIN products p ON p.id = b.product_id
   WHERE p.brand_id = :brandId AND c.status = 'flagged'
   ORDER BY c.scan_count DESC LIMIT 100`,
  { brandId },
);
---
<AppShell title="Suspicious codes" area="portal" userName={user.name}>
  <h1>Suspicious activity</h1>
  <p class="muted">Codes that exceeded scan limits or multi-city patterns.</p>
  <table class="data">
    <thead><tr><th>Code</th><th>Product</th><th>Batch</th><th>Scans</th></tr></thead>
    <tbody>
      {flagged.length === 0 ? (
        <tr><td colspan="4" class="muted">No flagged codes yet.</td></tr>
      ) : flagged.map((c) => (
        <tr>
          <td><code>{c.code}</code></td>
          <td>{c.product_name}</td>
          <td>{c.batch_label}</td>
          <td>{c.scan_count}/{c.scan_limit}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AppShell>
