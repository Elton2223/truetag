---
import Base from '../layouts/Base.astro';
import Result from '../components/Result.astro';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../content/site';
---
<Base title="How to verify">
  <div class="wrap page-head"><h1>How to verify</h1></div>
  <section style="padding-top:1rem">
    <div class="wrap grid three">
      <div class="card tile"><span class="ico"><Icon name="scan" /></span><h3>Scan</h3><p>Point your camera at the QR code.</p></div>
      <a class="card tile" href={whatsappLink('Hi True Tag, I want to check a product.')} style="text-decoration:none;color:inherit"><span class="ico"><Icon name="chat" /></span><h3>WhatsApp</h3><p>Send us the code. SMS coming soon.</p></a>
      <a class="card tile" href="/demo" style="text-decoration:none;color:inherit"><span class="ico"><Icon name="type" /></span><h3>Type</h3><p>Enter the code on our site.</p></a>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap grid three">
      <Result verdict="genuine" />
      <Result verdict="suspicious" />
      <Result verdict="invalid" />
    </div>
  </section>
</Base>
