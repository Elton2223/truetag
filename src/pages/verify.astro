---
import Base from '../layouts/Base.astro';
import Checker from '../components/Checker.astro';
import { verdictCopy } from '../content/site';

export const prerender = false;
---
<Base title="Check a product">
  <div class="wrap page-head" style="max-width:720px">
    <h1>Check a product</h1>
    <p class="muted">Scan the QR on the pack, or type the code. Free, no app needed.</p>
  </div>
  <section style="padding-top:1rem">
    <div class="wrap" style="max-width:720px">
      <Checker id="verify-checker" demo fromUrl />
      <p class="muted" style="margin-top:1rem">Suspect a fake without a code? <a href="/report">Report it</a>.</p>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap">
      <h2>What the results mean</h2>
      <div class="verdict-row">
        <div class="g"><strong>Genuine</strong><span>{verdictCopy.genuine.text}</span></div>
        <div class="s"><strong>Suspicious</strong><span>{verdictCopy.suspicious.text}</span></div>
        <div class="n"><strong>Not found</strong><span>No record of this code. It does not prove a fake, only that the brand may not be on True Tag.</span></div>
      </div>
    </div>
  </section>
</Base>
