---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
---
<Base title="About">
  <div class="wrap page-head"><p class="eyebrow">About</p><h1>Built in South Africa, for South Africans</h1></div>
  <section style="padding-top:1rem">
    <div class="wrap grid two">
      <div class="card"><h2>Mission</h2><p>{site.mission}</p></div>
      <div class="card"><h2>Vision</h2><p>{site.vision}</p></div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2>Founders</h2>
      <div class="grid two">
        {site.founders.map((f) => (
          <div class="card">
            <div class="photo" role="img" aria-label={`Photo of ${f.name} to be added`}>Photo placeholder</div>
            <h3 style="margin-top:1rem">{f.name}</h3>
            <p class="eyebrow">{f.role}</p>
            <p>{f.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <h2>Get in touch</h2>
      <p><a style="color:#fff" href={`mailto:${site.email}`}>{site.email}</a><br />{site.address}</p>
    </div>
  </section>
</Base>
