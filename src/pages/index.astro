---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import Checker from '../components/Checker.astro';
import { site } from '../content/site';
---
<Base title="Is it genuine? Find out before you buy.">
  <section class="hero">
    <div class="blob a"></div><div class="blob b"></div>
    <div class="wrap hero-grid">
      <div>
        <h1 data-i18n="hero.title">Is it genuine? Find out before you buy.</h1>
        <p class="lead">Check any alcohol or tobacco product in seconds. Free, no app needed.</p>
        <ul class="methods">
          <li><span class="ico"><Icon name="scan" /></span>Scan the QR code on the pack</li>
          <li><span class="ico"><Icon name="type" /></span>Or type the code printed on it</li>
          <li><span class="ico"><Icon name="chat" /></span>WhatsApp and SMS checks <small>coming soon</small></li>
        </ul>
      </div>
      <Checker id="hero-checker" />
    </div>
  </section>

  <div class="trust">
    <div class="wrap">
      <ul>
        <li>Independent of the industries we protect</li>
        <li>Built for SARS and NCC track-and-trace</li>
        <li>No app needed</li>
        <li>Based in Durban, South Africa</li>
      </ul>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">How it works</span>
        <h2>Three seconds to know</h2>
      </div>
      <div class="how-grid">
        <ol class="vsteps">
          <li><span class="num"><Icon name="scan" /></span><div><h3>Scan or type</h3><p>Scan the QR on the pack, or enter the code.</p></div></li>
          <li><span class="num"><Icon name="shield" /></span><div><h3>Get the verdict</h3><p>Genuine, suspicious or not found, in plain words.</p></div></li>
          <li><span class="num"><Icon name="flag" /></span><div><h3>Act on it</h3><p>Report a fake, or claim a reward when the brand offers one.</p></div></li>
        </ol>
        <PhoneMock />
      </div>
    </div>
  </section>

  <section class="band stats">
    <div class="wrap">
      <span class="eyebrow" style="color:#8db1b9">The cost of fakes</span>
      <h2 style="margin-top:.4rem">Illicit trade is a South African crisis</h2>
      <div class="grid three" style="margin-top:2.5rem">
        {site.figures.map((f) => (
          <div class="figure-wrap">
            <div class="figure" data-count={f.count} data-prefix={f.prefix} data-suffix={f.suffix}>{f.prefix}{f.count}{f.suffix}</div>
            <p class="muted" style="margin:.2rem 0 0">{f.label}</p>
            {f.source && <p class="source">{f.source}</p>}
          </div>
        ))}
      </div>
      <p class="note">Counterfeit alcohol has killed. True Tag lets anyone check before they buy.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">Who it is for</span>
        <h2>One tag, two kinds of trust</h2>
      </div>
      <div class="split">
        <div class="panel shop">
          <Icon name="phone" />
          <h3>For shoppers</h3>
          <ul>
            <li>Free, every time</li>
            <li>Clear verdict in seconds</li>
            <li>Rewards when brands offer them</li>
          </ul>
          <a class="btn dark" href="/verify">Check a product</a>
        </div>
        <div class="panel brand-p">
          <Icon name="chart" />
          <h3>For brands</h3>
          <ul>
            <li>Unique code on every pack</li>
            <li>See scans, flags and places</li>
            <li>Evidence to act on fakes</li>
          </ul>
          <a class="btn" href="/brands#pilot">Request a pilot</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="closing">
        <h2>Ready to protect your brand?</h2>
        <div class="cta-row">
          <a class="btn" href="/brands#pilot">Request a pilot</a>
          <a class="btn ghost" href="/contact">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
