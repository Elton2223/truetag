---
import Base from '../layouts/Base.astro';
import Result from '../components/Result.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink, demoCodes, verdictCopy } from '../content/site';
const sample = demoCodes['TT-DEMO-1001'];
---
<Base title="Is it genuine? Find out before you buy.">
  <section class="hero">
    <div class="blob a"></div><div class="blob b"></div>
    <div class="wrap hero-grid">
      <div>
        <h1 data-i18n="hero.title">Is it genuine? Find out before you buy.</h1>
        <form class="verify-box" action="/demo" method="get">
          <label for="code" class="sr-only">Product code</label>
          <input id="code" name="code" placeholder="Type the code" autocomplete="off" required />
          <button class="btn" type="submit">Check it</button>
        </form>
        <a href={whatsappLink('Hi True Tag, I want to check a product.')}>Or check on WhatsApp</a>
      </div>
      <div>
        <div class="hero-card" id="hero-card" aria-live="off">
          <Result verdict="genuine" product={sample.product} detail={sample.detail} code="TT-DEMO-1001" />
        </div>
        <div class="dots" id="dots" aria-hidden="true"><i class="on"></i><i></i><i></i></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap grid three center">
      {site.figures.map((f) => (
        <div class="figure-wrap">
          <div class="figure" data-count={f.count} data-prefix={f.prefix} data-suffix={f.suffix}>{f.prefix}{f.count}{f.suffix}</div>
          <p class="muted">{f.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap grid three">
      <div class="card tile"><span class="ico"><Icon name="gift" /></span><h3>Scan to engage</h3><p>Verify, then get rewarded.</p></div>
      <div class="card tile"><span class="ico"><Icon name="phone" /></span><h3>No app needed</h3><p>Camera, WhatsApp or SMS.</p></div>
      <div class="card tile"><span class="ico"><Icon name="shield" /></span><h3>Government-ready</h3><p>Built for track-and-trace.</p></div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap center">
      <div class="cta-row" style="justify-content:center">
        <a class="btn dark" href="/demo">Check a product</a>
        <a class="btn" href="/brands#pilot">Request a pilot</a>
      </div>
    </div>
  </section>

  <script define:vars={{ demoCodes, verdictCopy }}>
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var card = document.getElementById('hero-card');
    var dots = document.querySelectorAll('#dots i');
    var codes = Object.keys(demoCodes);
    var icons = { genuine: '\u2713', suspicious: '!', invalid: '?' };
    var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var i = 0;
    function render(n) {
      var code = codes[n], d = demoCodes[code], c = verdictCopy[d.verdict];
      card.innerHTML = '<div class="result ' + d.verdict + '"><span class="badge pop"><span aria-hidden="true">' + icons[d.verdict] + '</span> ' + c.title + '</span>' +
        '<p class="muted" style="margin:.6rem 0 0">Code: <strong>' + esc(code) + '</strong></p><h3>' + esc(d.product) + '</h3>' +
        '<p style="margin-bottom:.4rem">' + esc(d.detail || c.text) + '</p>' + (c.advice ? '<p class="advice">' + esc(c.advice) + '</p>' : '') + '</div>';
      dots.forEach(function (el, k) { el.classList.toggle('on', k === n); });
    }
    if (!reduce) setInterval(function () { i = (i + 1) % codes.length; render(i); }, 3800);
  </script>
</Base>
