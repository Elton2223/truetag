---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import { site, whatsappLink } from '../content/site';
---
<Base title="Is it genuine? Find out before you buy.">
  <section class="hero">
    <div class="blob a"></div><div class="blob b"></div>
    <div class="wrap hero-grid">
      <div>
        <h1 data-i18n="hero.title">Is it genuine? Find out before you buy.</h1>
        <p class="lead">Free product check for alcohol and tobacco. No app needed.</p>
        <form class="verify-box" action="/demo" method="get">
          <label for="code" class="sr-only">Product code</label>
          <input id="code" name="code" placeholder="Enter the code on the pack" autocomplete="off" required />
          <button class="btn" type="submit">Check it</button>
        </form>
        <div class="hero-links">
          <a href={whatsappLink('Hi True Tag, I want to check a product.')}>Check on WhatsApp</a>
          <a href="/verify">How it works</a>
        </div>
      </div>
      <PhoneMock />
    </div>
  </section>

  <div class="trust">
    <div class="wrap">
      <ul>
        <li>Independent of the industries we protect</li>
        <li>Built for SARS and NCC track-and-trace</li>
        <li>No app needed</li>
        <li>Based in Durban, South Africa</li>
      </ul>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">How it works</span>
        <h2>Three seconds to know</h2>
      </div>
      <ol class="flow">
        <li><span class="num"><Icon name="scan" /></span><h3>Scan</h3><p>Camera, WhatsApp or type the code.</p></li>
        <li><span class="num"><Icon name="shield" /></span><h3>Verdict</h3><p>Genuine, suspicious or not found.</p></li>
        <li><span class="num"><Icon name="flag" /></span><h3>Act</h3><p>Report a fake or enjoy your reward.</p></li>
      </ol>
    </div>
  </section>

  <section class="band stats">
    <div class="wrap">
      <span class="eyebrow" style="color:#8db1b9">The cost of fakes</span>
      <h2 style="margin-top:.4rem">Illicit trade is a South African crisis</h2>
      <div class="grid three" style="margin-top:2.5rem">
        {site.figures.map((f) => (
          <div class="figure-wrap">
            <div class="figure" data-count={f.count} data-prefix={f.prefix} data-suffix={f.suffix}>{f.prefix}{f.count}{f.suffix}</div>
            <p class="muted" style="margin:.2rem 0 0">{f.label}</p>
            {f.source && <p class="source">{f.source}</p>}
          </div>
        ))}
      </div>
      <p class="note">Counterfeit alcohol has killed. True Tag lets anyone check before they buy.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">Who it is for</span>
        <h2>One tag, two kinds of trust</h2>
      </div>
      <div class="split">
        <div class="panel shop">
          <Icon name="phone" />
          <h3>For shoppers</h3>
          <ul>
            <li>Free, every time</li>
            <li>Clear verdict in seconds</li>
            <li>Rewards after you verify</li>
          </ul>
          <a class="btn dark" href="/demo">Check a product</a>
        </div>
        <div class="panel brand-p">
          <Icon name="chart" />
          <h3>For brands</h3>
          <ul>
            <li>Unique code on every pack</li>
            <li>See scans, flags and places</li>
            <li>Evidence to act on fakes</li>
          </ul>
          <a class="btn" href="/brands#pilot">Request a pilot</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="closing">
        <h2>Ready to protect your brand?</h2>
        <div class="cta-row">
          <a class="btn" href="/brands#pilot">Request a pilot</a>
          <a class="btn ghost" href={whatsappLink('Hi True Tag, I am a brand and I would like to enquire.')}>WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
