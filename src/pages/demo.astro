---
import Base from '../layouts/Base.astro';
import { whatsappLink } from '../content/site';

export const prerender = false;

const samples = ['TT-DEMO-1001', 'TT-DEMO-2002', 'TT-DEMO-3003'];
const initial = Astro.url.searchParams.get('code') || '';
---
<Base title="Demo scan">
  <div class="wrap page-head"><h1>Try it</h1>
    <p class="muted">Live check against the True Tag registry (seeded demo codes).</p>
  </div>
  <section style="padding-top:1rem">
    <div class="wrap grid two">
      <div>
        <form class="verify-box" id="demo-form" style="margin-top:0">
          <label for="code" class="sr-only">Product code</label>
          <input id="code" name="code" placeholder="TT-DEMO-1001" autocomplete="off" required value={initial} />
          <button class="btn" type="submit">Check it</button>
        </form>
        <p>
          {samples.map((c) => (
            <button class="btn ghost sample" type="button" data-code={c} style="margin:0 .4rem .4rem 0;padding:.4rem 1rem">{c}</button>
          ))}
        </p>
        <div class="cta-row">
          <a class="btn" href="/brands#pilot">Request a pilot</a>
          <a class="btn ghost" href={whatsappLink('Hi True Tag, I saw the demo and want to enquire.')}>WhatsApp</a>
          <a class="btn ghost" href="/report">Report a fake</a>
        </div>
      </div>
      <div id="out" aria-live="polite" style="min-height:260px">
        <div class="card muted center" style="padding:3rem 1rem">Pick a code</div>
      </div>
    </div>
  </section>
  <script>
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var out = document.getElementById('out');
    var input = document.getElementById('code');
    var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var icons = { genuine: '\u2713', suspicious: '!', invalid: '?' };
    var titles = { genuine: 'Genuine', suspicious: 'Suspicious', invalid: 'Not found' };

    function paint(data) {
      var verdict = data.verdict || 'invalid';
      var title = titles[verdict] || 'Not found';
      var html = '<div class="result ' + verdict + '" role="status" style="animation:slidein .5s ease both">' +
        '<span class="badge pop"><span aria-hidden="true">' + (icons[verdict] || '?') + '</span> ' + esc(title) + '</span>' +
        '<p class="muted" style="margin:.6rem 0 0">Code: <strong>' + esc(data.code || '') + '</strong></p>' +
        (data.product ? '<h3>' + esc(data.product) + '</h3>' : '') +
        (data.brand ? '<p class="muted" style="margin:0 0 .4rem">' + esc(data.brand) + (data.batch ? ' · ' + esc(data.batch) : '') + '</p>' : '') +
        '<p style="margin-bottom:.4rem">' + esc(data.detail || '') + '</p>' +
        (data.advice ? '<p class="advice">' + esc(data.advice) + '</p>' : '') +
        (data.rewardEligible ? '<p class="muted" style="margin-top:.8rem">Reward available — token saved for the brand campaign.</p>' : '') +
        '</div>';
      out.innerHTML = html;
    }

    function show(raw) {
      var code = String(raw || '').trim();
      if (!code) return;
      if (!reduce) out.innerHTML = '<div class="card checking" aria-label="Checking"><i></i><i></i><i></i></div>';
      fetch('/api/v1/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code, channel: 'demo' }),
      })
        .then(function (r) { return r.json(); })
        .then(paint)
        .catch(function () {
          out.innerHTML = '<div class="card"><p>Could not reach the registry. Is MySQL running?</p></div>';
        });
    }

    document.getElementById('demo-form').addEventListener('submit', function (e) {
      e.preventDefault();
      show(input.value);
    });
    document.querySelectorAll('.sample').forEach(function (b) {
      b.addEventListener('click', function () {
        input.value = b.dataset.code;
        show(b.dataset.code);
      });
    });
    if (input.value) show(input.value);
  </script>
</Base>
