---
import Base from '../layouts/Base.astro';
import { whatsappLink, demoCodes, verdictCopy } from '../content/site';
---
<Base title="Demo scan">
  <div class="wrap page-head"><h1>Try it</h1></div>
  <section style="padding-top:1rem">
    <div class="wrap grid two">
      <div>
        <form class="verify-box" id="demo-form" style="margin-top:0">
          <label for="code" class="sr-only">Product code</label>
          <input id="code" name="code" placeholder="TT-DEMO-1001" autocomplete="off" required />
          <button class="btn" type="submit">Check it</button>
        </form>
        <p>
          {Object.keys(demoCodes).map((c) => (
            <button class="btn ghost sample" type="button" data-code={c} style="margin:0 .4rem .4rem 0;padding:.4rem 1rem">{c}</button>
          ))}
        </p>
        <div class="cta-row">
          <a class="btn" href="/brands#pilot">Request a pilot</a>
          <a class="btn ghost" href={whatsappLink('Hi True Tag, I saw the demo and want to enquire.')}>WhatsApp</a>
        </div>
      </div>
      <div id="out" aria-live="polite" style="min-height:260px">
        <div class="card muted center" style="padding:3rem 1rem">Pick a code</div>
      </div>
    </div>
  </section>
  <script define:vars={{ demoCodes, verdictCopy }}>
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var out = document.getElementById('out');
    var input = document.getElementById('code');
    var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var icons = { genuine: '\u2713', suspicious: '!', invalid: '?' };
    var timer;
    function paint(code) {
      var hit = demoCodes[code];
      var verdict = hit ? hit.verdict : 'invalid';
      var c = verdictCopy[verdict];
      out.innerHTML = '<div class="result ' + verdict + '" role="status" style="animation:slidein .5s ease both">' +
        '<span class="badge pop"><span aria-hidden="true">' + icons[verdict] + '</span> ' + c.title + '</span>' +
        '<p class="muted" style="margin:.6rem 0 0">Code: <strong>' + esc(code) + '</strong></p>' +
        (hit ? '<h3>' + esc(hit.product) + '</h3>' : '') +
        '<p style="margin-bottom:.4rem">' + esc((hit && hit.detail) || c.text) + '</p>' +
        (c.advice ? '<p class="advice">' + esc(c.advice) + '</p>' : '') + '</div>';
    }
    function show(raw) {
      var code = raw.trim().toUpperCase();
      if (!code) return;
      clearTimeout(timer);
      if (reduce) return paint(code);
      out.innerHTML = '<div class="card checking" aria-label="Checking"><i></i><i></i><i></i></div>';
      timer = setTimeout(function () { paint(code); }, 700);
    }
    document.getElementById('demo-form').addEventListener('submit', function (e) { e.preventDefault(); show(input.value); });
    document.querySelectorAll('.sample').forEach(function (b) { b.addEventListener('click', function () { input.value = b.dataset.code; show(b.dataset.code); }); });
    var q = new URLSearchParams(location.search).get('code');
    if (q) { input.value = q; show(q); }
  </script>
</Base>
