---
import '../styles/global.css';
import { site, whatsappLink } from '../content/site';
import { languages, strings } from '../i18n/strings';
interface Props { title: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/verify', key: 'nav.verify' },
  { href: '/demo', key: 'nav.demo' },
  { href: '/brands', key: 'nav.brands' },
  { href: '/about', key: 'nav.about' },
];
const t = (k: string) => strings.en[k];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f3d47" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | {site.name}</title>
  </head>
  <body>
    <div class="nav-wrap">
      <div class="wrap">
        <nav class="nav" aria-label="Main">
          <a class="brand" href="/"><img src={site.logo} alt="" width="26" height="36" />{site.name}</a>
          <ul>
            {links.map((l) => (
              <li><a href={l.href} data-i18n={l.key} aria-current={path === l.href ? 'page' : undefined}>{t(l.key)}</a></li>
            ))}
            <li>
              <label class="sr" for="lang" style="position:absolute;left:-9999px">Language</label>
              <select id="lang" class="lang">
                {Object.entries(languages).map(([code, name]) => <option value={code}>{name}</option>)}
              </select>
            </li>
            <li><a class="btn" href="/brands#pilot" data-i18n="nav.cta">{t('nav.cta')}</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <main><slot /></main>
    <footer>
      <div class="wrap">
        <div class="cols">
          <div>
            <span class="foot-logo"><img src={site.logoFull} alt="True Tag" /></span>
            <p>Independent product authentication for alcohol and tobacco, based in {site.city}.</p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/verify">How to verify</a></li>
              <li><a href="/demo">Demo scan</a></li>
              <li><a href="/report">Report a fake</a></li>
              <li><a href="/brands">For brands</a></li>
              <li><a href="/portal/login">Brand portal</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="/privacy">Privacy policy</a></li>
              <li><a href="/terms">Terms</a></li>
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={whatsappLink()}>WhatsApp us</a></li>
              <li>{site.address}</li>
            </ul>
          </div>
        </div>
        <p class="legal">&copy; 2026 {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
    <script define:vars={{ strings }}>
      const sel = document.getElementById('lang');
      const apply = (lang) => {
        document.documentElement.lang = lang;
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const k = el.getAttribute('data-i18n');
          el.textContent = (strings[lang] && strings[lang][k]) || strings.en[k] || el.textContent;
        });
      };
      const saved = localStorage.getItem('tt-lang') || 'en';
      sel.value = saved; apply(saved);
      sel.addEventListener('change', () => { localStorage.setItem('tt-lang', sel.value); apply(sel.value); });
    </script>
  <script is:inline>
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var navWrap = document.querySelector('.nav-wrap');
        var onScroll = function () { navWrap.classList.toggle('scrolled', scrollY > 20); };
        addEventListener('scroll', onScroll, { passive: true }); onScroll();

        var fmt = function (el, v) { el.textContent = (el.dataset.prefix || '') + Math.round(v) + (el.dataset.suffix || ''); };
        var count = function (el) {
          var end = +el.dataset.count;
          if (reduce) return fmt(el, end);
          var start = performance.now(), dur = 1400;
          (function step(now) {
            var p = Math.min((now - start) / dur, 1);
            fmt(el, end * (1 - Math.pow(1 - p, 3)));
            if (p < 1) requestAnimationFrame(step);
          })(start);
        };
        var els = document.querySelectorAll('main .card, main .tile, main .steps li, main .timeline li, main .chips li, main h2, main .page-head > *, main .hero-grid > *, main .figure-wrap, main .cta-row');
        if (!reduce && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('in');
              e.target.querySelectorAll('[data-count]').forEach(count);
              if (e.target.hasAttribute('data-count')) count(e.target);
              io.unobserve(e.target);
            });
          }, { threshold: 0.15 });
          els.forEach(function (el, i) {
            var sibs = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
            el.style.setProperty('--d', Math.min(sibs, 5) * 90 + 'ms');
            el.classList.add('reveal'); io.observe(el);
          });
          setTimeout(function () {
            els.forEach(function (el) {
              if (!el.classList.contains('in') && el.getBoundingClientRect().top < innerHeight) el.classList.add('in');
            });
          }, 1200);
        } else {
          document.querySelectorAll('[data-count]').forEach(count);
        }
      })();
    </script>
  </body>
</html>
